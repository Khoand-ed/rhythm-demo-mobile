{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "promuse",
    "Audience": "promuse-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimit": {
    "AuthPermitPerMinute": 20
  },
  "Stamina": {
    "MinutesPerPoint": 3
  },
  "Missions": {
    "TimeZoneOffsetHours": 7,
    "ResetHourLocal": 4
  }
}
