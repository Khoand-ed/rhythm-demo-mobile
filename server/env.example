# Copy to server/.env and edit. The .env itself is gitignored.
#
#   cp server/env.example server/.env
#
# Named without the leading dot so it is obviously a template and never gets
# loaded by anything expecting real values.
#
# These values configure docker-compose.yml. The API reads its connection
# string from appsettings / user-secrets instead, so the container's
# configuration and the application's cannot drift apart unnoticed - this file
# configures the database, not the service that talks to it.

POSTGRES_USER=promuse
POSTGRES_DB=promuse

# Development only. Anything reachable from outside a laptop needs a real
# secret, and that does not belong in a file tracked anywhere near this one.
POSTGRES_PASSWORD=promuse_dev_only

# Change if 5432 is already taken on the host.
POSTGRES_PORT=5432
