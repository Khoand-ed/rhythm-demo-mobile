      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "promuse_deployment_info",
          "legendFormat": "{{environment}}: {{image}}",
          "refId": "A",
          "instant": true,
          "range": false
