# The edge for the local rehearsal (rehearse.sh) - names under .localhost, which browsers and
# curl send to this machine and Caddy serves with a certificate from its own CA. Nothing here is
# a secret: these values never leave this machine.
STAGING_HOST=staging.localhost
PRODUCTION_HOST=promuse.localhost
GRAFANA_HOST=grafana.localhost
ACME_EMAIL=rehearsal@example.com
GRAFANA_ADMIN_PASSWORD=local-rehearsal-only
# Nothing listens here unless you start something on port 9999; alerts then fail to send, which
# Grafana shows on its contact point.
DISCORD_WEBHOOK_URL=http://host.docker.internal:9999/discord
MONITOR_DB_PASSWORD=localmonitor0123456789
# Local only: Caddy is published on 8443 (edge.override.yml), and its certificates come from its
# own CA, which the probe and the scripts are told to accept.
EDGE_HTTPS_PORT=8443
PROBE_INSECURE_TLS=true
